# Copy this file to .env next to compose.yaml and fill it in.
# .env is gitignored: it holds the broker address and the credentials, and none
# of them belong in a config file or in this repository.

MQTT_BROKER=tcp://192.0.2.10:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional: compose.yaml already defaults this to warn, which logs only what is
# not working. Set it to info to add one line per message including its payload,
# which is how you debug a rule that is not firing -- and which puts your device
# readings in docker logs until the container is replaced.
#MQTT2PROMETHEUS_LOG_LEVEL=info
